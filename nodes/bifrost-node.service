[Unit]
Description=Bifrost Zero-Knowledge Egress Node Agent (HTTP CONNECT)
Documentation=https://github.com/sxamx/bifrost
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=bifrost-node
Group=bifrost-node
WorkingDirectory=/opt/bifrost-node/nodes
Environment=NODE_ENV=production
Environment=BIFROST_NODE_MODE=tailscale
Environment=BIFROST_NODE_PORT=9443
Environment=BIFROST_NODE_DATA_DIR=/var/lib/bifrost-node
Environment=BIFROST_NODE_REPO_DIR=/opt/bifrost-node
Environment=NPM_CONFIG_CACHE=/var/lib/bifrost-node/.npm
EnvironmentFile=-/etc/default/bifrost-node
ExecStart=/usr/bin/env node /opt/bifrost-node/nodes/dist/index.js
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bifrost-node

# Systemd security hardening (V8 JIT-compatible)
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bifrost-node /opt/bifrost-node
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=true

[Install]
WantedBy=multi-user.target
