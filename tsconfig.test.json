{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["./core/node_modules/@types"]
  },
  "include": [
    "tests/**/*.test.ts",
    "tests/helpers/**/*.ts",
    "nodes/nodes.test.ts"
  ]
}
